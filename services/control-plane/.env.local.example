# Pantheon control-plane — local secrets/config.
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values, then run `npm start`
# (the start script loads `.env.local` automatically via node --env-file-if-exists). Values set in
# your shell still override these. NEVER commit `.env.local`.

# --- Auth (required to run) ---
# Bearer token for API/headless access (any long random string; e.g. `openssl rand -hex 32`).
ADMIN_API_TOKEN=
# Passphrase you type at /login to use the harness in a browser. Omit to disable browser login.
PANTHEON_OPERATOR_PASSWORD=
# Set to true ONLY when served over HTTPS (adds the Secure flag to the session cookie).
PANTHEON_SECURE_COOKIES=false

# --- Storage / custody ---
# Persistent registry DB and the harness SSH key custody dir (must match what you provisioned with).
PANTHEON_DB=/Users/karl/.pantheon/control-plane.db
PANTHEON_KEY_DIR=/Users/karl/.pantheon/keys

# --- Listen address ---
PORT=8088
HOST=0.0.0.0

# --- Optional downstreams ---
# Peta admin API (enables MCP-server registration on the Config page).
# PETA_URL=
# PETA_ADMIN_TOKEN=
# Gitea + Alden Bridge (used by the chat pipeline / provisioning when wired).
# GITEA_BASE_URL=
# GITEA_TOKEN=
# BRIDGE_MCP_URL=
# BRIDGE_MCP_TOKEN=
