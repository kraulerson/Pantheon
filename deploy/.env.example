# Pantheon Harness deploy — compose environment. Copy to deploy/.env (GITIGNORED) and fill.
# NEVER commit the filled file. Generate secrets with: openssl rand -hex 32

# ---- Peta datastore ----
DB_USER=peta
DB_PASSWORD=            # openssl rand -hex 32
DB_NAME=peta
DB_PORT=5433            # host-side localhost bind (5433 avoids clashing with any host postgres)

# ---- Peta core ----
NODE_ENV=production
BACKEND_PORT=3002       # Peta listens here, published to 127.0.0.1 only
JWT_SECRET=             # openssl rand -hex 32
LOG_LEVEL=info
LOG_PRETTY=false
LAZY_START_ENABLED=false
PETA_AUTH_AUTOSTART=false
MCP_2026_ENABLED=true

# ---- LibreChat ----
MEILI_MASTER_KEY=       # openssl rand -hex 32
# LibreChat's own required secrets (see its .env docs; VERIFY names against the pinned
# version's .env.example at deploy time):
CREDS_KEY=              # openssl rand -hex 32
CREDS_IV=               # openssl rand -hex 16
JWT_SECRET_LIBRECHAT=   # openssl rand -hex 32  (map to LibreChat's JWT_SECRET in compose env if needed)
JWT_REFRESH_SECRET=     # openssl rand -hex 32
