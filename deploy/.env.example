# Pantheon Harness deploy — compose environment. Copy to deploy/.env (GITIGNORED) and fill.
# NEVER commit the filled file. Generate secrets with: openssl rand -hex 32

# ---- Peta datastore ----
DB_USER=peta
DB_PASSWORD=            # openssl rand -hex 32
DB_NAME=peta
DB_PORT=5433            # host-side localhost bind (5433 avoids clashing with any host postgres)

# ---- Peta core ----
NODE_ENV=production
BACKEND_PORT=3002       # Peta listens here, published to 127.0.0.1 only
JWT_SECRET=             # openssl rand -hex 32
LOG_LEVEL=info
LOG_PRETTY=false
LAZY_START_ENABLED=false
PETA_AUTH_AUTOSTART=false
MCP_2026_ENABLED=true

# ---- LibreChat ----
MEILI_MASTER_KEY=       # openssl rand -hex 32
# LibreChat's own required secrets (see its .env docs; VERIFY names against the pinned
# version's .env.example at deploy time):
CREDS_KEY=              # openssl rand -hex 32
CREDS_IV=               # openssl rand -hex 16
JWT_SECRET_LIBRECHAT=   # openssl rand -hex 32  (map to LibreChat's JWT_SECRET in compose env if needed)
JWT_REFRESH_SECRET=     # openssl rand -hex 32

# Self-signup on the chat UI. FALSE is the deployed posture — accounts are created during a
# short, deliberate signup window and the flag goes back to false immediately (see
# deploy/README.md). LibreChat also defaults this to false; it is set explicitly so the
# posture is visible rather than inherited.
ALLOW_REGISTRATION=false

# Profile-menu "Help & FAQ" item. LibreChat exposes NO supported hook for adding a custom entry
# to that menu, so the one configurable entry is repointed at the Pantheon admin console
# (operator's choice 2026-08-19, over injecting a "Switch to Admin" item into the compiled UI).
# Note the value is only returned in LibreChat's POST-login config payload — an unauthenticated
# GET /api/config will not show it, which is not a fault.
HELP_AND_FAQ_URL=https://pantheon-admin.ferrumcorde.com
