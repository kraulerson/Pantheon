# Pantheon Harness deploy — compose environment. Copy to deploy/.env (GITIGNORED) and fill.
# NEVER commit the filled file. Generate secrets with: openssl rand -hex 32

# ---- Peta datastore ----
DB_USER=peta
DB_PASSWORD=            # openssl rand -hex 32
DB_NAME=peta
DB_PORT=5433            # host-side localhost bind (5433 avoids clashing with any host postgres)

# ---- Peta core ----
NODE_ENV=production
BACKEND_PORT=3002       # Peta listens here, published to 127.0.0.1 only
JWT_SECRET=             # openssl rand -hex 32
LOG_LEVEL=info
LOG_PRETTY=false
LAZY_START_ENABLED=false
PETA_AUTH_AUTOSTART=false
MCP_2026_ENABLED=true

# ---- LibreChat ----
MEILI_MASTER_KEY=       # openssl rand -hex 32
# LibreChat's own required secrets (see its .env docs; VERIFY names against the pinned
# version's .env.example at deploy time):
CREDS_KEY=              # openssl rand -hex 32
CREDS_IV=               # openssl rand -hex 16
JWT_SECRET_LIBRECHAT=   # openssl rand -hex 32  (map to LibreChat's JWT_SECRET in compose env if needed)
JWT_REFRESH_SECRET=     # openssl rand -hex 32

# Self-signup on the chat UI. FALSE is the deployed posture — accounts are created during a
# short, deliberate signup window and the flag goes back to false immediately (see
# deploy/README.md). LibreChat also defaults this to false; it is set explicitly so the
# posture is visible rather than inherited.
ALLOW_REGISTRATION=false

# Profile-menu "Help & FAQ" item -> the user guide (ruling 2026-08-19). It briefly pointed at the
# admin console instead; the "Switch to Admin" footer link now covers that, so Help means help.
# The guide is served WITHOUT login so this link always resolves.
# Note the value is only returned in LibreChat's POST-login config payload — an unauthenticated
# GET /api/config will not show it, which is not a fault.
HELP_AND_FAQ_URL=https://pantheon.ferrumcorde.com/harness/help

# Markdown line rendered under the chat box — the one place LibreChat lets us put a custom LABEL
# (the profile menu / sidebar cannot take a custom entry). Ruling 2026-08-27: the harness lives
# UNDER this address at /harness/ (Terminals = machines + tmux sessions + terminal tabs + Approvals;
# Configuration = registering machines, keycards, endpoints). Relative links stay on this address.
# Like HELP_AND_FAQ_URL, this value only appears in the POST-login config payload.
CUSTOM_FOOTER=[Terminals](/harness/) | [Configuration](/harness/admin/config)

# Basic-LLM chat endpoints (librechat.yaml, ruling 2026-08-26). The 27B brain on the 7900XTX box
# enforces an API key: copy the value of /etc/llama-qwen/apikey on that box here. Never commit it.
# The Alden-1 brain server takes no key today, so it needs nothing here.
LLM_MINI_API_KEY=

# Chat-page sign-in length (ruling 2026-08-26). LibreChat keeps you signed in for the life of its
# refresh token — 7 days by default — and the value is in MILLISECONDS. Karl chose 30 days.
# Needs `docker compose up -d librechat` (recreate) to take effect, like every .env change.
REFRESH_TOKEN_EXPIRY=2592000000
